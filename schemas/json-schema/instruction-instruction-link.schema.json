{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/InstructionLink",
  "definitions": {
    "InstructionLink": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string"
        },
        "rel": {
          "$ref": "#/definitions/LinkRel"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "target"
      ],
      "additionalProperties": false
    },
    "LinkRel": {
      "type": "string",
      "enum": [
        "related",
        "prerequisite",
        "sequel",
        "part-of",
        "see-also"
      ]
    }
  }
}
